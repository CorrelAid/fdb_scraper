  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#idHash",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "md5 of id_url, hex. Primary key of the published table and the key the version history groups by. A digest of the identifier rather than an identifier of its own: it is stable exactly as long as the source URL is"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
    ],
