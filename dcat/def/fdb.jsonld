      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#onWebsiteFrom",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ISO week (e.g. 2026-W34) in which this programme was first present in the export. An observation of ours, not a date the source states: the export ships only its current state, so nothing before this dataset's first load is visible. The week named is the one before the load that first saw it -- the week the appearance fell in. Null when that load was the first one of all: it has no week before it, and a programme it found was already on the site when we started looking, so its arrival is not observable and any week here would be invented. Those rows are identifiable as the ones whose first_scraped_at is the earliest in the table"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on_website_from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://fdb.cdl.correlaid.org/def/fdb#origin": [
      {
        "@value": "derived"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#onWebsiteTo",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "last ISO week in which this programme was still present in the export -- so, like the other week columns, the week the departure fell in rather than the week we noticed it. No shift is applied here because none is needed: the last load that still saw the programme is already the one before the load that found it gone. Null for programmes still present, which means 'still there' and not 'unknown'. For absent programmes this may be much later than the last content change (last_updated), and it is always known -- a departure is only ever observed with a load on either side of it, unlike on_website_from, which is null when the programme predates the first load"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "on_website_to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://fdb.cdl.correlaid.org/def/fdb#origin": [
      {
        "@value": "derived"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#origin",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Where a column's values come from: \"upstream\" -- stated by the source export and only reshaped; \"derived\" -- computed from upstream values or from the load history by a rule, exactly and reproducibly; \"inferred\" -- produced by a machine-learning model, therefore neither deterministic nor exact. The inferred columns are keywords_extracted; their accuracy is measured against a labelled sample rather than guaranteed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "origin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#previousUpdateDates",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "one ISO week per observed content change, ascending. Each names the week the change fell in rather than the week we looked: a load reports only that something differs from the load before it, so the week named is the one before the load that found the change. Empty for a programme that has never changed. Its length is the number of weeks in which a change was seen, not the number of changes: a week is a single comparison between two loads, so two changes within one week are indistinguishable from one. For absent programmes, excludes the final transition (the absence), containing only actual content changes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://fdb.cdl.correlaid.org/def/fdb#Foerderprogramm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
