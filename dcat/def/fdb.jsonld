      {
        "@value": "derived"
      }
    ]
  },
  {
    "@id": "https://fdb.cdl.correlaid.org/def/fdb#keywords",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
